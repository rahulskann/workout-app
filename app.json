{
  "expo": {
    "name": "SplitCycle",
    "slug": "workout-cycle-app",
    "version": "1.0.0",
    "scheme": "splitcycle",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "android": {
      "package": "com.rahulkannan.splitcycle",
      "backgroundColor": "#121212"
    },
    "ios": {
      "bundleIdentifier": "com.rahulkannan.splitcycle",
      "supportsTablet": false
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos of exercises and gym machines.",
          "cameraPermission": "Take photos and videos of exercises and gym machines.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3fe0beb4-f2d8-401e-8e08-fa7317da6b67"
      }
    }
  }
}
